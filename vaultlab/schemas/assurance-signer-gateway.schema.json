{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enteleclos.com/schemas/assurance-signer-gateway-case.v2.json",
  "title": "EnteleVAULT assurance signer gateway conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "observedAt", "environment", "caller", "request", "receipt", "transport", "replay", "provider"],
  "properties": {
    "schema": { "const": "entelevault.assurance-signer-gateway-case.v2" },
    "caseId": { "type": "string", "pattern": "^gateway_[0-9a-f]{32}$" },
    "observedAt": { "type": "string", "format": "date-time" },
    "environment": { "const": "staging" },
    "caller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "subject", "owner", "ownerId", "project", "projectId", "deploymentEnvironment", "sourceRevision", "tokenLifetimeSeconds", "runtimeIdentityVerified"],
      "properties": {
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "subject": { "type": "string" },
        "owner": { "type": "string" },
        "ownerId": { "type": "string" },
        "project": { "type": "string" },
        "projectId": { "type": "string" },
        "deploymentEnvironment": { "type": "string" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tokenLifetimeSeconds": { "type": "integer", "minimum": 1, "maximum": 3900 },
        "runtimeIdentityVerified": { "type": "boolean" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "method", "purpose", "keyPurpose", "algorithms", "receiptDigest", "sourceRevision", "canonicalReceiptStatus", "commandPath", "requestBytes"],
      "properties": {
        "schema": { "type": "string" },
        "method": { "type": "string" },
        "purpose": { "type": "string" },
        "keyPurpose": { "type": "string" },
        "algorithms": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["Ed25519", "ML-DSA-65"] } },
        "receiptDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "canonicalReceiptStatus": { "enum": ["exact", "mismatched", "unparseable", "unknown"] },
        "commandPath": { "type": "boolean" },
        "requestBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "receiptId", "challenge", "purpose", "issuer", "audience", "subject", "environment", "sourceRevision", "issuedAt", "expiresAt", "policyVersion", "decision", "evidenceDigest", "commandPath", "controls"],
      "properties": {
        "schema": { "type": "string" },
        "receiptId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{24}$" },
        "challenge": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "purpose": { "type": "string" },
        "issuer": { "type": "string" },
        "audience": { "type": "string" },
        "subject": { "type": "string" },
        "environment": { "type": "string" },
        "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "policyVersion": { "type": "string" },
        "decision": { "enum": ["allow", "deny"] },
        "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "commandPath": { "type": "boolean" },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["humanQuorum", "hardwareBackedKeys", "transactionSimulation", "destinationPolicy", "rateLimits", "recoveryDrillCurrent", "workloadIdentity", "productionRevisionBound", "cryptoInventoryComplete"],
          "properties": {
            "humanQuorum": { "type": "boolean" },
            "hardwareBackedKeys": { "type": "boolean" },
            "transactionSimulation": { "type": "boolean" },
            "destinationPolicy": { "type": "boolean" },
            "rateLimits": { "type": "boolean" },
            "recoveryDrillCurrent": { "type": "boolean" },
            "workloadIdentity": { "type": "boolean" },
            "productionRevisionBound": { "type": "boolean" },
            "cryptoInventoryComplete": { "type": "boolean" }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tlsVersion", "redirectPolicy", "contentType", "trustedSourceVerified", "maximumRequestBytes", "maximumResponseBytes"],
      "properties": {
        "tlsVersion": { "enum": ["TLS1.2", "TLS1.3"] },
        "redirectPolicy": { "enum": ["error", "follow"] },
        "contentType": { "enum": ["application/json", "application/octet-stream"] },
        "trustedSourceVerified": { "type": "boolean" },
        "maximumRequestBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maximumResponseBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestChallenge", "observedReceiptId", "challengeStatus", "receiptIdStatus", "idempotencyStatus", "rateLimitStatus"],
      "properties": {
        "requestChallenge": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
        "observedReceiptId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{24}$" },
        "challengeStatus": { "enum": ["fresh", "replayed", "mismatched", "malformed", "unknown"] },
        "receiptIdStatus": { "enum": ["unique", "duplicate", "malformed", "unknown"] },
        "idempotencyStatus": { "enum": ["new", "duplicate", "unknown"] },
        "rateLimitStatus": { "enum": ["within-limit", "exceeded", "unknown"] }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyProtection", "hardwareBacked", "keyExportPolicy", "purposeIsolation", "auditSinkAvailable", "independentAssessmentApproved", "classicalSignatureAvailable", "postQuantumSignatureAvailable"],
      "properties": {
        "keyProtection": { "enum": ["hsm", "cloud-hsm", "managed-kms", "mpc", "software"] },
        "hardwareBacked": { "type": "boolean" },
        "keyExportPolicy": { "enum": ["prohibited", "allowed", "unknown"] },
        "purposeIsolation": { "type": "boolean" },
        "auditSinkAvailable": { "type": "boolean" },
        "independentAssessmentApproved": { "type": "boolean" },
        "classicalSignatureAvailable": { "type": "boolean" },
        "postQuantumSignatureAvailable": { "type": "boolean" }
      }
    }
  }
}
