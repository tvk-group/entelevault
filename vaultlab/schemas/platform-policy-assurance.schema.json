{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enteleclos.com/schemas/platform-policy-assurance.v2.json",
  "title": "EnteleCLOS platform policy assurance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "scope", "result", "authorityGranted", "summary", "checks"],
  "properties": {
    "schema": { "const": "enteleclos.platform-policy-assurance.v2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": { "const": "sanitized-metadata-only" },
    "result": { "enum": ["PASS", "FAIL"] },
    "authorityGranted": { "const": false },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "const": 6 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evaluatedCases"],
        "properties": {
          "id": {
            "enum": [
              "VL-PLATFORM-SIGNING",
              "VL-PLATFORM-RECOVERY",
              "VL-PLATFORM-CUSTODY",
              "VL-PLATFORM-WITHDRAWAL",
              "VL-PLATFORM-PROVENANCE",
              "VL-PLATFORM-INCIDENT"
            ]
          },
          "status": { "enum": ["PASS", "FAIL"] },
          "evaluatedCases": { "type": "integer", "minimum": 1, "maximum": 16384 }
        }
      }
    }
  }
}
