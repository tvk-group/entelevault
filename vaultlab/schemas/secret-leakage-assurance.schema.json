{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enteleclos.com/schemas/secret-leakage-assurance.v1.json",
  "title": "EnteleCLOS secret-leakage assurance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "assessmentId", "assessedAt", "environment", "component", "scanClass", "policyRevision", "rulesetDigest", "controls", "findings", "evidenceDigest"],
  "properties": {
    "schema": { "const": "enteleclos.secret-leakage-assurance.v1" },
    "assessmentId": { "type": "string", "pattern": "^leak_[0-9a-f]{32}$" },
    "assessedAt": { "type": "string", "format": "date-time" },
    "environment": { "enum": ["ci", "staging", "production-observation"] },
    "component": { "enum": ["enteleclos-assurance", "enteleexchange-api", "enteleexchange-web", "entelevault-service", "entelewallet-client"] },
    "scanClass": { "enum": ["release", "runtime-telemetry", "support-export", "incident-evidence"] },
    "policyRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "rulesetDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structuredLogScanPassed", "traceScanPassed", "crashReportScanPassed", "buildArtifactScanPassed", "supportExportScanPassed", "clientTelemetryScanPassed", "highEntropyDetectionEnabled", "secretPatternDetectionEnabled", "redactionVerificationPassed", "canaryDetectionPassed", "scannerRulesetPinned", "independentReviewComplete"],
      "properties": {
        "structuredLogScanPassed": { "type": "boolean" },
        "traceScanPassed": { "type": "boolean" },
        "crashReportScanPassed": { "type": "boolean" },
        "buildArtifactScanPassed": { "type": "boolean" },
        "supportExportScanPassed": { "type": "boolean" },
        "clientTelemetryScanPassed": { "type": "boolean" },
        "highEntropyDetectionEnabled": { "type": "boolean" },
        "secretPatternDetectionEnabled": { "type": "boolean" },
        "redactionVerificationPassed": { "type": "boolean" },
        "canaryDetectionPassed": { "type": "boolean" },
        "scannerRulesetPinned": { "type": "boolean" },
        "independentReviewComplete": { "type": "boolean" }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialClassHits", "tokenClassHits", "keyMaterialClassHits", "walletMaterialClassHits", "unclassifiedEntropyHits"],
      "properties": {
        "credentialClassHits": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "tokenClassHits": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "keyMaterialClassHits": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "walletMaterialClassHits": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "unclassifiedEntropyHits": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
