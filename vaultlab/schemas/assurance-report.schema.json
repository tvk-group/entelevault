{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entelevault.com/schemas/vaultlab/assurance-report.v1.json",
  "title": "EnteleVAULT VaultLab assurance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "controlSet",
    "generatedAt",
    "scope",
    "fixtureId",
    "result",
    "summary",
    "durationMs",
    "checks"
  ],
  "properties": {
    "schema": { "const": "entelevault.vaultlab.assurance-report.v1" },
    "controlSet": { "const": "ENTELE-VAULTLAB-1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": { "const": "synthetic-only" },
    "fixtureId": { "type": "string", "pattern": "^vlab_[0-9a-f]{32}$" },
    "result": { "enum": ["PASS", "FAIL"] },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "durationMs": { "type": "number", "minimum": 0 },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^VL-[A-Z0-9-]+$" },
          "status": { "enum": ["PASS", "FAIL"] },
          "statement": { "type": "string", "maxLength": 200 },
          "reason": { "type": "string", "maxLength": 120 },
          "rejectionCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
        },
        "additionalProperties": false
      }
    }
  }
}
